# Rahasia & Konfigurasi Lingkungan KurmaFlow
AUTH_SECRET=super_secret_auth_key_change_in_production_min_32_chars!
ACCOUNT_KEY_SECRET=super_secret_key_enc_secret_change_in_production_32ch!

# Database PostgreSQL bersama di VPS (container 'postgres' di network Docker 'internal'), db/user 'snapgen'
POSTGRES_URL=postgresql+asyncpg://snapgen:GANTI_PASSWORD@postgres:5432/snapgen

# SnapGen AI Provider API
SNAPGEN_API_BASE=https://api.snapgen.ai

# Port Web Publik (Default: 3001)
WEB_PORT=3001

# LLM Perkaya Prompt (Endpoint kompatibel OpenAI, opsional)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Observabilitas & Webhook (Opsional)
ALERT_WEBHOOK_URL=
GLITCHTIP_DSN=

# Keamanan & CORS (pisahkan dengan koma, atau kosongkan untuk menerima domain VPS)
ALLOWED_ORIGINS=*

